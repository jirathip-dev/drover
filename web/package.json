{
  "name": "herdsman-web",
  "private": true,
  "type": "module",
  "description": "#265: the TypeScript board; `npm run build` writes dist/ (committed, embedded in the binary)",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --minify --format=esm --target=es2020 --outfile=dist/board.js && esbuild src/board.css --bundle --minify --outfile=dist/board.css",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
